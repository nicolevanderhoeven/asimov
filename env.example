# Copy this file to .env and fill it in: cp env.example .env
# .env is git-ignored. Never commit real keys or tokens, here or anywhere else.
# Where each value comes from: docs/grafana-cloud-setup.md
# Check your settings with: make doctor
#
# Keep the KEY=value form, with no spaces around the = sign: the game, Docker
# Compose, and the k6 scripts all read this file.

# ---------------------------------------------------------------------------
# Required to play with the AI game master (not needed for --offline)
# ---------------------------------------------------------------------------
# From https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# ---------------------------------------------------------------------------
# Required to send telemetry to Grafana Cloud (not needed with --no-telemetry)
# ---------------------------------------------------------------------------
# Generations and conversations. In Grafana: Observability > Agent
# Observability > Configuration. Copy its API URL and Instance ID.
AGENTO11Y_ENDPOINT=https://sigil-prod-REGION.grafana.net
GRAFANA_CLOUD_INSTANCE_ID=
# A Cloud Access Policy token (glc_...) with the sigil:write, metrics:write,
# logs:write, and traces:write scopes. It is shown only once.
GRAFANA_CLOUD_API_KEY=

# Traces, metrics, and logs. On grafana.com, open your stack's OpenTelemetry
# card: copy its OTLP endpoint and its Instance ID, which may be a different
# number from the one above. Skip "Generate now": the token above covers OTLP.
OTLP_ENDPOINT=https://otlp-gateway-prod-REGION.grafana.net/otlp
# Base64 of "OTLP_INSTANCE_ID:TOKEN", with no "Basic " prefix. Build it with:
#   printf '%s' 'OTLP_INSTANCE_ID:glc_...' | base64
OTLP_HEADERS=

# ---------------------------------------------------------------------------
# Optional
# ---------------------------------------------------------------------------
# The GM's model. Defaults to claude-sonnet-4-6.
# ANTHROPIC_MODEL=claude-sonnet-4-6
# The agent version Agent Observability groups generations by.
# Defaults to go-experiment-v1.
# ASIMOV_AGENT_VERSION=go-experiment-v1
