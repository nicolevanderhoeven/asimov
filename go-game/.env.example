# Copy to .env and run with --env .env, or reuse the root ../.env.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# Generations -> Grafana Agent Observability
AGENTO11Y_ENDPOINT=https://YOUR-ENDPOINT/api/v1/generations:export
GRAFANA_CLOUD_INSTANCE_ID=
GRAFANA_CLOUD_API_KEY=
# Existing GRAFANA_CLOUD_SIGIL_ENDPOINT is accepted instead of AGENTO11Y_ENDPOINT.
# Experiments and scores (cmd/traj) use this API base; defaults to the endpoint's host.
# AGENTO11Y_API_ENDPOINT=https://YOUR-ENDPOINT

# Traces, metrics, and logs -> Grafana Cloud OTLP gateway
OTLP_ENDPOINT=https://YOUR-OTLP-GATEWAY/otlp
# Base64 of instance_id:otlp_write_token, as in the Python app.
OTLP_HEADERS=
ASIMOV_AGENT_VERSION=go-experiment-v1
