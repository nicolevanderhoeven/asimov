    {
      "id": 11,
      "type": "timeseries",
      "title": "Operations, running total",
      "description": "gen_ai_client_operation_duration count: model calls (the game streams them: streamText) and tool executions (execute_tool). Model calls need the AI game master (make play-local-observed).",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 22
