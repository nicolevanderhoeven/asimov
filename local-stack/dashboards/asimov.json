    {
      "id": 19,
      "type": "stat",
      "title": "Estimated total cost",
      "description": "What the model calls in the selected range would cost at list price. This is an estimate: it multiplies input and output tokens by Anthropic's list price per million tokens for each model (gen_ai_request_model), and cached tokens are not separated, so cache reads and writes are billed at the plain rate. Prices are the dashboard constants price_* (Settings, Variables); models without a price there are left out. Totals are over the selected time range.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 0,
        "y": 38
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
