      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (gen_ai_operation_name, gen_ai_request_model, gen_ai_tool_name) (max_over_time(gen_ai_client_operation_duration_seconds_count[$__range]))",
          "legendFormat": "{{gen_ai_operation_name}} {{gen_ai_request_model}}{{gen_ai_tool_name}}",
          "range": true
